{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StubRules": {
    "IdNow": [
      { "Id": "idnow-invalid", "Match": "idnow:INVALID", "DocumentResult": "INVALID", "FaceMatch": true, "Confidence": 0.95 },
      { "Id": "idnow-face-mismatch", "Match": "idnow:FACE_MISMATCH", "DocumentResult": "VALID", "FaceMatch": false, "Confidence": 0.41 },
      { "Id": "idnow-inconclusive", "Match": "idnow:INCONCLUSIVE", "DocumentResult": "INCONCLUSIVE", "FaceMatch": true, "Confidence": 0.62 },
      { "Id": "idnow-low-confidence", "Match": "idnow:LOW_CONFIDENCE", "DocumentResult": "VALID", "FaceMatch": true, "Confidence": 0.70 },
      { "Id": "idnow-flaky", "Match": "idnow:FLAKY", "FailTimes": 2 },
      { "Id": "idnow-down", "Match": "idnow:DOWN", "FailTimes": -1 },
      { "Id": "idnow-slow", "Match": "idnow:SLOW", "LatencyMs": 15000 }
    ],
    "WorldCheck": [
      { "Id": "wc-possible-match", "Match": "PossibleMatch", "Status": "POSSIBLE_MATCH", "ListType": "SANCTIONS", "Score": 0.82 },
      { "Id": "wc-auto-clear", "Match": "AutoClear", "Status": "POSSIBLE_MATCH", "ListType": "PEP", "Score": 0.71, "AutoResolveAfterSeconds": 20, "AutoResolution": "FALSE_POSITIVE" },
      { "Id": "wc-sanctioned", "Match": "Sanctioned", "Status": "POSSIBLE_MATCH", "ListType": "SANCTIONS", "Score": 0.97, "AutoResolveAfterSeconds": 20, "AutoResolution": "TRUE_MATCH" },
      { "Id": "wc-flaky", "Match": "Flaky", "FailTimes": 2 },
      { "Id": "wc-down", "Match": "Unreachable", "FailTimes": -1 }
    ]
  }
}
