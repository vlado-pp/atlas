{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://127.0.0.1:5341"
  },
  "Persistence": {
    "DatabaseNameFormat": "atlas_{market}",
    "Markets": [ "MA", "MB", "MC", "MD", "ME", "MF" ],
    "MigrateOnStartup": false
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672
  },
  "Documents": {
    "MaxDocumentBytes": 8388608
  },
  "Providers": {
    "IdNow": {
      "AttemptTimeout": "00:00:10",
      "TotalTimeout": "00:00:30",
      "MaxRetryAttempts": 2
    },
    "WorldCheck": {
      "AttemptTimeout": "00:00:10",
      "TotalTimeout": "00:00:30",
      "MaxRetryAttempts": 2
    }
  },
  "Workflow": {
    "PollInterval": "00:00:01",
    "BatchSize": 20,
    "Lease": "00:02:00",
    "RetryBaseDelay": "00:00:05",
    "RetryMaxDelay": "00:05:00",
    "StalledAfterAttempts": 10
  },
  "Markets": {
    "MA": {
      "Identifiers": [ { "Scheme": "PersonalNumber", "Pattern": "^[0-9]{13}$", "CheckDigit": "None" } ],
      "Activation": { "Mode": "Remote" }
    },
    "MB": {
      "Identifiers": [ { "Scheme": "PersonalNumber", "Pattern": "^[0-9]{13}$", "CheckDigit": "None" } ],
      "Activation": { "Mode": "Remote" }
    },
    "MC": {
      "Identifiers": [ { "Scheme": "UnifiedCitizenId", "Pattern": "^[A-Z0-9]{8}[A-Z]$", "CheckDigit": "None" } ],
      "Activation": { "Mode": "Remote" }
    },
    "MD": {
      "Identifiers": [ { "Scheme": "CitizenNumber", "Pattern": "^[0-9]{10}$", "CheckDigit": "None" } ],
      "Activation": { "Mode": "InPersonBranch", "BranchVisitDeadlineDays": 30 }
    },
    "ME": {
      "Identifiers": [ { "Scheme": "CivilNumber", "Pattern": "^[0-9]{10}$", "CheckDigit": "None" } ],
      "Activation": { "Mode": "Remote" }
    },
    "MF": {
      "Identifiers": [
        { "Scheme": "PersonalNumber", "Pattern": "^[0-9]{13}$", "CheckDigit": "None" },
        { "Scheme": "Passport", "Pattern": "^[A-Z0-9]{6,9}$", "CheckDigit": "None", "IsPassport": true }
      ],
      "Activation": { "Mode": "Remote" }
    }
  }
}
