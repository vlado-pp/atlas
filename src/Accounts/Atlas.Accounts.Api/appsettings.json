{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Seq": {
    "ServerUrl": "http://127.0.0.1:5341"
  },
  "Persistence": {
    "DatabaseNameFormat": "atlas_{market}",
    "Markets": [ "MA", "MB", "MC", "MD", "ME", "MF" ],
    "MigrateOnStartup": false
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672
  },
  "FakeGateways": {
    "CoreBankingFailuresBeforeSuccess": 0,
    "CardProcessorFailuresBeforeSuccess": 0
  }
}
